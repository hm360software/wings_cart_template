<%
  const placeholders = {
    domain: 'example.com',
    epp: 'Enter EPP/Auth code'
  };
%>

<div id="order-standard_cart" class="order-domain py-4">
  <div class="container-fluid">
    <div class="row g-4">

      <!-- FULL WIDTH FIXED -->
      <div class="col-12">

        <div class="card shadow-sm">
          <div class="card-body">

            <div class="mb-4">
              <p class="text-uppercase text-muted small mb-1">Shopping Cart</p>
              <h3 class="mb-0">Transfer your domain to us</h3>
              <small class="text-muted">Transfer now to extend your domain by 1 year*</small>
            </div>

            <form class="border rounded p-4 bg-light" method="post" action="/orderforms/<%= formId %>/domain"
              id="domainTransferForm">
              <input type="hidden" name="_csrf" value="<%= typeof csrfTokenValue !== 'undefined' && csrfTokenValue ? csrfTokenValue : (typeof token !== 'undefined' ? token : '') %>">
              <input type="hidden" name="domainOption" value="transfer">

              <!-- Domain Name -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Domain Name</label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0">
                    <i class="fas fa-globe text-muted"></i>
                  </span>
                  <input type="text" class="form-control border-start-0" name="transferSld"
                    placeholder="<%= placeholders.domain %>" value="<%= domainSelection?.domain || '' %>">
                </div>
                <div class="form-text text-muted">Please enter your domain</div>
              </div>

              <!-- Authorization Code -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Authorization Code</label>
                <div class="input-group">
                  <input type="text" class="form-control" name="transferEpp" placeholder="<%= placeholders.epp %>">
                  <span class="input-group-text bg-white">
                    <a href="#" class="text-decoration-none">
                      <i class="fas fa-question-circle me-1"></i>Help
                    </a>
                  </span>
                </div>
              </div>

              <!-- Captcha -->
              <div class="mb-4">
                <label class="form-label fw-semibold">Captcha</label>
                <div class="d-flex align-items-center gap-3">
                  <div class="border rounded p-2 bg-white">
                    <img src="/orderforms/<%= formId %>/assets/img/globe.png" height="40" alt="captcha">
                  </div>
                  <input type="text" class="form-control" placeholder="Enter code">
                </div>
              </div>

              <div class="text-end">
                <button type="submit" class="btn btn-primary px-4">
                  Add to Cart
                </button>
              </div>

            </form>

            <small class="text-muted d-block mt-3">
              *TLDs exclude certain ccTLDs and recently renewed domains.
            </small>

          </div>
        </div>

        <!-- Bottom Boxes -->
        <div class="row g-3 mt-4">

          <div class="col-md-6">
            <div class="border rounded p-3 h-100">
              <h6>Add Web Hosting</h6>
              <p class="text-muted mb-3">
                Choose high-performance hosting packages to launch your website instantly.
              </p>
              <a href="/clientarea/services?context=order" class="btn btn-outline-primary btn-sm">
                Explore packages
              </a>
            </div>
          </div>

          <div class="col-md-6">
            <div class="border rounded p-3 h-100">
              <h6>Looking to register?</h6>
              <p class="text-muted mb-3">
                Browse TLD pricing and register a new domain name with us.
              </p>
              <a href="/orderforms/<%= formId %>?step=domain&mode=register" class="btn btn-outline-primary btn-sm">
                Register domain
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</div>


