<script>
    (function () {
        // Toggle "Create New Account" form for logged-in users
        const accountExisting = document.getElementById('accountExisting');
        const accountNew = document.getElementById('accountNew');
        const newAccountForm = document.getElementById('newAccountForm');

        if (accountExisting && accountNew && newAccountForm) {
            function toggleNewAccountForm() {
                if (accountNew.checked) {
                    newAccountForm.style.display = 'block';
                    // Make new account fields required
                    const requiredFields = newAccountForm.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], select');
                    requiredFields.forEach(field => {
                        if (field.name && field.name.includes('_new') && !field.name.includes('companyname')) {
                            field.required = true;
                        }
                    });
                } else {
                    newAccountForm.style.display = 'none';
                    // Remove required attribute
                    const requiredFields = newAccountForm.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], select');
                    requiredFields.forEach(field => {
                        field.required = false;
                    });
                }
            }

            accountExisting.addEventListener('change', toggleNewAccountForm);
            accountNew.addEventListener('change', toggleNewAccountForm);
        }

        // Generate Password (for non-logged-in users)
        const generatePasswordBtn = document.getElementById('generatePassword');
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.querySelector('input[name="confirmPassword"]');
        const generatedPasswordModal = document.getElementById('generatedPasswordModal');
        const generatedPasswordDisplay = document.getElementById('generatedPasswordDisplay');
        const copyPasswordBtn = document.getElementById('copyPasswordBtn');
        const usePasswordBtn = document.getElementById('usePasswordBtn');
        const passwordCopiedAlert = document.getElementById('passwordCopiedAlert');

        function generateSecurePassword() {
            const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*';
            let password = '';
            for (let i = 0; i < 12; i++) {
                password += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return password;
        }

        function showPasswordModal(password) {
            if (generatedPasswordDisplay) {
                generatedPasswordDisplay.value = password;
            }
            
            // Hide copied alert if visible
            if (passwordCopiedAlert) {
                passwordCopiedAlert.classList.add('d-none');
            }

            // Show modal using Bootstrap if available, otherwise use vanilla JS
            if (generatedPasswordModal) {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    const bsModal = new bootstrap.Modal(generatedPasswordModal);
                    bsModal.show();
                } else {
                    // Fallback: show modal manually
                    generatedPasswordModal.style.display = 'block';
                    generatedPasswordModal.classList.add('show');
                    document.body.classList.add('modal-open');
                    const backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop fade show';
                    backdrop.id = 'generatedPasswordModalBackdrop';
                    document.body.appendChild(backdrop);
                }
            }
        }

        function closePasswordModal() {
            if (generatedPasswordModal) {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    try {
                        const bsModal = bootstrap.Modal.getInstance(generatedPasswordModal);
                        if (bsModal) {
                            bsModal.hide();
                            // Ensure backdrop is removed after Bootstrap hides modal
                            setTimeout(function() {
                                const backdrops = document.querySelectorAll('.modal-backdrop');
                                backdrops.forEach(function(backdrop) {
                                    if (backdrop.parentNode) {
                                        backdrop.remove();
                                    }
                                });
                                document.body.classList.remove('modal-open');
                                document.body.style.overflow = '';
                                document.body.style.paddingRight = '';
                            }, 300);
                        } else {
                            const newModal = new bootstrap.Modal(generatedPasswordModal);
                            newModal.hide();
                            setTimeout(function() {
                                const backdrops = document.querySelectorAll('.modal-backdrop');
                                backdrops.forEach(function(backdrop) {
                                    if (backdrop.parentNode) {
                                        backdrop.remove();
                                    }
                                });
                                document.body.classList.remove('modal-open');
                                document.body.style.overflow = '';
                                document.body.style.paddingRight = '';
                            }, 300);
                        }
                    } catch (e) {
                        console.error('Error closing modal:', e);
                        hidePasswordModalManually();
                    }
                } else {
                    hidePasswordModalManually();
                }
            }
        }

        function hidePasswordModalManually() {
            if (generatedPasswordModal) {
                generatedPasswordModal.style.display = 'none';
                generatedPasswordModal.classList.remove('show');
            }
            // Remove all modal backdrops
            const backdrops = document.querySelectorAll('.modal-backdrop');
            backdrops.forEach(function(backdrop) {
                if (backdrop.parentNode) {
                    backdrop.remove();
                }
            });
            // Also remove specific backdrop if exists
            const specificBackdrop = document.getElementById('generatedPasswordModalBackdrop');
            if (specificBackdrop && specificBackdrop.parentNode) {
                specificBackdrop.remove();
            }
            // Unlock body
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
        }

        if (generatePasswordBtn) {
            generatePasswordBtn.addEventListener('click', function () {
                const password = generateSecurePassword();
                showPasswordModal(password);
            });
        }

        // Copy password to clipboard
        if (copyPasswordBtn && generatedPasswordDisplay) {
            copyPasswordBtn.addEventListener('click', function () {
                const password = generatedPasswordDisplay.value;
                if (password) {
                    // Copy to clipboard
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(password).then(function() {
                            // Show success message
                            if (passwordCopiedAlert) {
                                passwordCopiedAlert.classList.remove('d-none');
                                setTimeout(function() {
                                    passwordCopiedAlert.classList.add('d-none');
                                }, 3000);
                            }
                            // Update button text temporarily
                            const originalHtml = copyPasswordBtn.innerHTML;
                            copyPasswordBtn.innerHTML = '<i class="fas fa-check me-2"></i>Copied!';
                            setTimeout(function() {
                                copyPasswordBtn.innerHTML = originalHtml;
                            }, 2000);
                        }).catch(function(err) {
                            console.error('Failed to copy password:', err);
                            alert('Failed to copy password. Please copy it manually.');
                        });
                    } else {
                        // Fallback for older browsers
                        generatedPasswordDisplay.select();
                        generatedPasswordDisplay.setSelectionRange(0, 99999);
                        try {
                            document.execCommand('copy');
                            if (passwordCopiedAlert) {
                                passwordCopiedAlert.classList.remove('d-none');
                                setTimeout(function() {
                                    passwordCopiedAlert.classList.add('d-none');
                                }, 3000);
                            }
                        } catch (err) {
                            alert('Failed to copy password. Please copy it manually.');
                        }
                    }
                }
            });
        }

        // Use password button - fills the password fields and closes modal
        if (usePasswordBtn && passwordInput) {
            usePasswordBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                const password = generatedPasswordDisplay ? generatedPasswordDisplay.value : '';
                if (password) {
                    // Fill password fields
                    passwordInput.value = password;
                    if (confirmPasswordInput) {
                        confirmPasswordInput.value = password;
                    }
                    // Update password strength indicator
                    updatePasswordStrength(password);
                    
                    // Close modal with a small delay to ensure fields are updated
                    setTimeout(function() {
                        closePasswordModal();
                    }, 100);
                } else {
                    alert('No password generated. Please try again.');
                }
            });
        }

        // Close modal on backdrop click
        if (generatedPasswordModal) {
            generatedPasswordModal.addEventListener('click', function (e) {
                if (e.target === generatedPasswordModal) {
                    closePasswordModal();
                }
            });
        }

        // Also handle close button click
        const closePasswordModalBtn = generatedPasswordModal ? generatedPasswordModal.querySelector('.btn-close') : null;
        if (closePasswordModalBtn) {
            closePasswordModalBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                closePasswordModal();
            });
        }

        // Handle "Close" button in modal
        const closePasswordBtn = generatedPasswordModal ? generatedPasswordModal.querySelector('button[data-bs-dismiss="modal"]') : null;
        if (closePasswordBtn) {
            closePasswordBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                closePasswordModal();
            });
        }

        // Password Strength Checker
        function updatePasswordStrength(password) {
            const strengthBar = document.getElementById('passwordStrength');
            const strengthText = document.getElementById('passwordStrengthText');
            if (!strengthBar || !strengthText) return;

            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/\d/)) strength++;
            if (password.match(/[^a-zA-Z\d]/)) strength++;

            const percentages = [0, 25, 50, 75, 100];
            const colors = ['danger', 'danger', 'warning', 'success', 'success'];
            const texts = ['Very Weak', 'Weak', 'Moderate', 'Strong', 'Very Strong'];

            strengthBar.style.width = percentages[strength] + '%';
            strengthBar.className = 'progress-bar bg-' + colors[strength];
            strengthText.textContent = texts[strength];
        }

        if (passwordInput) {
            passwordInput.addEventListener('input', function () {
                updatePasswordStrength(this.value);
            });
        }

        // Form Validation for non-logged-in users
        const checkoutForm = document.getElementById('checkoutForm');
        if (checkoutForm) {
            checkoutForm.addEventListener('submit', function (e) {
                const password = passwordInput?.value;
                const confirmPassword = confirmPasswordInput?.value;

                if (password && confirmPassword && password !== confirmPassword) {
                    e.preventDefault();
                    alert('Passwords do not match!');
                    return false;
                }
            });
        }

        // Form submission handler for logged-in users - handle new account data
        const checkoutFormLoggedIn = document.getElementById('checkoutFormLoggedIn');
        if (checkoutFormLoggedIn) {
            checkoutFormLoggedIn.addEventListener('submit', function (e) {
                if (accountNew && accountNew.checked) {
                    // Map new account fields to regular field names for backend processing
                    const newAccountFields = newAccountForm.querySelectorAll('input, select');
                    newAccountFields.forEach(field => {
                        if (field.name && field.name.includes('_new')) {
                            const originalName = field.name.replace('_new', '');
                            const hiddenInput = document.createElement('input');
                            hiddenInput.type = 'hidden';
                            hiddenInput.name = originalName;
                            hiddenInput.value = field.value;
                            checkoutFormLoggedIn.appendChild(hiddenInput);
                        }
                    });
                }
            });
        }

        // Remove item modal handler
        const csrfToken = (typeof window.csrfToken === 'string' && window.csrfToken)
            ? window.csrfToken
            : <%- JSON.stringify(typeof csrfTokenValue !== 'undefined' && csrfTokenValue ? csrfTokenValue : (typeof token !== 'undefined' ? token : '')) %>;

        let removeUrl = null;
        const removeItemModal = document.getElementById('removeItemModal');
        if (removeItemModal && removeItemModal.parentElement !== document.body) {
            document.body.appendChild(removeItemModal);
        }

        function hideRemoveModal() {
            const modal = document.getElementById('removeItemModal');
            if (modal) {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal && typeof bootstrap.Modal.getInstance === 'function') {
                    const inst = bootstrap.Modal.getInstance(modal);
                    if (inst) {
                        try { inst.dispose(); } catch (err) { /* ignore */ }
                    }
                }
                modal.classList.remove('show');
                modal.style.display = 'none';
                modal.setAttribute('aria-hidden', 'true');
                modal.removeAttribute('aria-modal');
            }
            document.querySelectorAll('.modal-backdrop').forEach(function (el) { el.remove(); });
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
            removeUrl = null;
            const confirmBtn = document.getElementById('confirmRemoveBtn');
            if (confirmBtn) {
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Yes';
            }
        }

        function showRemoveModal() {
            const modal = document.getElementById('removeItemModal');
            if (!modal) return;
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
            modal.classList.add('show');
            modal.style.display = 'block';
            modal.style.zIndex = '20000';
            modal.removeAttribute('aria-hidden');
            modal.setAttribute('aria-modal', 'true');
            document.body.classList.add('modal-open');
            if (!document.getElementById('removeItemModalBackdrop')) {
                const backdrop = document.createElement('div');
                backdrop.className = 'modal-backdrop fade show';
                backdrop.id = 'removeItemModalBackdrop';
                backdrop.style.zIndex = '19990';
                document.body.appendChild(backdrop);
            }
        }

        function submitRemove() {
            if (!removeUrl) return;
            const confirmBtn = document.getElementById('confirmRemoveBtn');
            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Removing...';
            }
            const tempForm = document.createElement('form');
            tempForm.method = 'POST';
            tempForm.action = removeUrl;
            if (csrfToken) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = '_csrf';
                input.value = csrfToken;
                tempForm.appendChild(input);
            }
            document.body.appendChild(tempForm);
            tempForm.submit();
        }

        document.addEventListener('click', function (e) {
            const removeBtn = e.target.closest('.remove-item-btn');
            if (removeBtn) {
                e.preventDefault();
                e.stopPropagation();
                const form = removeBtn.closest('form');
                removeUrl = form ? form.getAttribute('action') : removeBtn.getAttribute('data-form-action');
                const modal = document.getElementById('removeItemModal');
                if (modal) {
                    const titleEl = modal.querySelector('#removeItemModalLabel');
                    const messageEl = modal.querySelector('.remove-modal-message');
                    if (titleEl) titleEl.textContent = removeBtn.getAttribute('data-confirm-title') || 'Remove Item';
                    if (messageEl) messageEl.textContent = removeBtn.getAttribute('data-confirm-message') || 'Are you sure you want to remove this item from your cart?';
                    showRemoveModal();
                }
                return;
            }

            if (e.target.closest('#confirmRemoveBtn')) {
                e.preventDefault();
                e.stopPropagation();
                submitRemove();
                return;
            }

            if (e.target.closest('#cancelRemoveBtn') || e.target.closest('#closeRemoveModalBtn')) {
                e.preventDefault();
                e.stopPropagation();
                hideRemoveModal();
                return;
            }

            if (e.target.id === 'removeItemModal' || e.target.id === 'removeItemModalBackdrop') {
                hideRemoveModal();
            }
        });
        })();
    </script>

    <!-- Location Utils for dynamic country/state/city selection -->
    <script src="/js/location-utils.js"></script>
    <script>
        (function() {
            // Initialize location dropdowns for non-logged-in users
            document.addEventListener('DOMContentLoaded', function() {
                // Initialize for main checkout form (non-logged-in)
                if (typeof LocationUtils !== 'undefined') {
                    LocationUtils.initLocationDropdowns({
                        countrySelectId: 'country',
                        stateSelectId: 'state',
                        citySelectId: 'city',
                        phoneCodeElementId: 'phoneCode'
                    });
                }

                // Initialize for new account form (logged-in users)
                if (typeof LocationUtils !== 'undefined') {
                    // Wait for new account form to be visible before initializing
                    const accountNew = document.getElementById('accountNew');
                    const newAccountForm = document.getElementById('newAccountForm');
                    
                    if (accountNew && newAccountForm) {
                        // Initialize when form becomes visible
                        function initNewAccountLocation() {
                            if (newAccountForm.style.display !== 'none') {
                                LocationUtils.initLocationDropdowns({
                                    countrySelectId: 'country_new',
                                    stateSelectId: 'state_new',
                                    citySelectId: 'city_new',
                                    phoneCodeElementId: 'phoneCode_new'
                                });
                            }
                        }

                        // Initialize on account type change
                        accountNew.addEventListener('change', function() {
                            if (this.checked) {
                                setTimeout(initNewAccountLocation, 100);
                            }
                        });

                        // Also try to initialize if form is already visible
                        if (newAccountForm.style.display !== 'none') {
                            setTimeout(initNewAccountLocation, 100);
                        }
                    }
                }
            });
        })();
    </script>
