<%
    const cartItems = (cart && Array.isArray(cart.items)) ? cart.items : [];
    const cartHasItems = cartItems.length > 0;
    const hasDomainItems = cartItems.some(item => item.type === 'domain');
    const hasProductItems = cartItems.some(item => !item.type || item.type !== 'domain');
    const currentCurrency = currency || cart?.currency || { prefix: '$', suffix: '', code: 'USD' };
    const currencyPrefix = currentCurrency.prefix || '';
    const currencySuffix = currentCurrency.suffix || (currentCurrency.code ? ` ${currentCurrency.code}` : '');
    
    // Calculate totals
    let subtotal = 0;
    cartItems.forEach(item => {
        if (item.price && item.price.value) {
            subtotal += parseFloat(item.price.value) || 0;
        }
    });
    
    // Promotion discount
    let discountAmount = 0;
    if (cart.promotion && cart.promotion.totalDiscount) {
        discountAmount = parseFloat(cart.promotion.totalDiscount) || 0;
    } else if (cart.discountAmount) {
        discountAmount = parseFloat(cart.discountAmount) || 0;
    }
    
    // Use tax calculation from context if available.
    let taxAmountAfterDiscount = 0;
    let total = 0;
    let taxRate = 0;
    
    if (typeof taxCalculation !== 'undefined' && taxCalculation) {
        // Use calculated tax from tax service
        taxAmountAfterDiscount = taxCalculation.totalTax || 0;
        total = taxCalculation.finalTotal || (subtotal - discountAmount);
        taxRate = taxCalculation.taxRateLevel1 || 0;
        if (taxCalculation.taxRateLevel2 > 0) {
            taxRate = taxCalculation.taxRateLevel1 + taxCalculation.taxRateLevel2;
        }
    } else {
        const subtotalAfterDiscount = subtotal - discountAmount;
        taxAmountAfterDiscount = 0;
        total = subtotalAfterDiscount;
    }
%>

<div id="order-standard_cart" class="py-4">
    <div class="container-fluid">
        <div class="row">
            <!-- Left Column: Product/Options -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h4 class="mb-0">Review & Checkout</h4>
                    </div>
                    <div class="card-body">
                        <% if (cartHasItems) { %>
                            <!-- Product/Options Header -->
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3"
                                style="background-color: #f8f9fa; padding: 10px; margin: -15px -15px 15px -15px;">
                                <div class="fw-semibold">Product/Options</div>
                                <div class="fw-semibold">Price/Cycle</div>
                            </div>

                            <!-- Cart Items -->
                            <% cartItems.forEach((item, index) => { %>
                                <div class="border-bottom pb-3 mb-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="mb-2">
                                                <div class="fw-semibold">
                                                    <%- (item.name || (item.type === 'domain' ? `${item.domain || 'Domain'}` : 'Product')).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/\n/g, '<br>') %>
                                                </div>
                                                <% if (item.type === 'domain') { %>
                                                    <small class="text-muted">
                                                        <%= item.domainMode === 'register' ? 'Domain Registration' : item.domainMode === 'transfer' ? 'Domain Transfer' : 'Domain Renewal' %>
                                                    </small>
                                                <% } else { %>
                                                    <% if (item.groupName) { %>
                                                        <small class="text-muted"><%= item.groupName %></small>
                                                    <% } %>
                                                <% } %>
                                                <% if (item.domain) { %>
                                                    <div class="mt-1">
                                                        <span class="text-primary"><%= item.domain %></span>
                                                        <% if (item.domainMode === 'existing' || (item.configuration && item.configuration.domainMode === 'existing')) { %>
                                                            <small class="text-muted ms-1">(existing domain)</small>
                                                        <% } %>
                                                    </div>
                                                <% } else if (item.configuration && item.configuration.domain) { %>
                                                    <div class="mt-1">
                                                        <span class="text-primary"><%= item.configuration.domain %></span>
                                                        <% if (item.configuration.domainMode === 'existing') { %>
                                                            <small class="text-muted ms-1">(existing domain)</small>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="mt-2">
                                                <a href="/orderforms/<%= formId %>?step=<%= item.type === 'domain' ? 'domain' : 'configure' %>&pid=<%= item.id %>&gid=<%= item.groupId || '' %>" 
                                                   class="text-decoration-none">
                                                    <i class="fas fa-pencil-alt me-1"></i>Edit
                                                </a>
                                            </div>
                                        </div>
                                        <div class="text-end ms-3 d-flex align-items-start gap-2">
                                            <div>
                                                <div class="fw-bold">
                                                    <%= item.price ? item.price.display : currencyPrefix + '0.00' + currencySuffix %>
                                                </div>
                                                <% if (item.type !== 'domain' && item.billingCycle) { %>
                                                    <small class="text-muted text-capitalize">
                                                        <%= item.billingCycle %>
                                                    </small>
                                                <% } else if (item.type === 'domain') { %>
                                                    <% 
                                                        const tld = item.domainTld || (item.domain ? '.' + item.domain.split('.').pop() : '');
                                                        const pricing = (typeof domainMultiYearPricing !== 'undefined' && domainMultiYearPricing[tld]) 
                                                                        ? domainMultiYearPricing[tld] 
                                                                        : null;
                                                        const mode = item.domainMode || 'register';
                                                    %>
                                                    <% if (pricing && pricing[mode]) { %>
                                                        <select class="form-select form-select-sm domain-period-select" 
                                                                data-item-id="<%= item.id %>" 
                                                                data-item-type="domain"
                                                                style="width: auto; display: inline-block;">
                                                            <% for (let year = 1; year <= 10; year++) { %>
                                                                <% if (pricing[mode][year] > 0) { %>
                                                                    <option value="<%= year %>" <%= item.domainYears == year ? 'selected' : '' %>>
                                                                        <%= year %> Year<%= year > 1 ? 's' : '' %> @ <%= currencyPrefix %><%= pricing[mode][year].toFixed(2) %><%= currencySuffix %>
                                                                    </option>
                                                                <% } %>
                                                            <% } %>
                                                        </select>
                                                    <% } else if (item.billingCycle) { %>
                                                        <small class="text-muted">
                                                            <%= item.billingCycle %>
                                                        </small>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                            <form method="POST" action="/orderforms/<%= formId %>/cart/remove/<%= item.id %>?from=review" 
                                                  class="d-inline remove-item-form"
                                                  data-item-id="<%= item.id %>"
                                                  onsubmit="return false;">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfTokenValue !== 'undefined' && csrfTokenValue ? csrfTokenValue : (typeof token !== 'undefined' ? token : '') %>">
                                                <button type="button" class="btn btn-link text-danger p-0 remove-item-btn" style="line-height: 1;" title="Remove item"
                                                        data-form-action="/orderforms/<%= formId %>/cart/remove/<%= item.id %>?from=review"
                                                        data-confirm-title="Remove Item"
                                                        data-confirm-message="Are you sure you want to remove this item from your cart?">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>

                            <!-- Empty Cart Button -->
                            <div class="mt-3">
                                <form method="POST" action="/orderforms/<%= formId %>/cart/clear?from=review"
                                      class="d-inline clear-cart-form"
                                      onsubmit="return false;">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfTokenValue !== 'undefined' && csrfTokenValue ? csrfTokenValue : (typeof token !== 'undefined' ? token : '') %>">
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-item-btn"
                                            data-form-action="/orderforms/<%= formId %>/cart/clear?from=review"
                                            data-confirm-title="Empty Cart"
                                            data-confirm-message="Are you sure you want to empty your cart?">
                                        <i class="fas fa-trash me-1"></i>Empty Cart
                                    </button>
                                </form>
                            </div>

                            <!-- Apply Promo Code Section -->
                            <div class="border-top pt-4 mt-4">
                                <div class="d-flex gap-2 mb-3 align-items-center">
                                    <button type="button" class="btn btn-sm" 
                                            style="background-color: #e9ecef; border: none;" 
                                            id="promoCodeTab">
                                        Apply Promo Code
                                    </button>
                                    <button type="button" class="btn btn-sm btn-link text-primary p-0" 
                                            id="estimateTaxesTab">
                                        Estimate Taxes
                                    </button>
                                </div>
                                
                                <div id="promoCodeSection">
                                    <div class="input-group mb-3">
                                        <span class="input-group-text bg-white border-end-0">
                                            <i class="fas fa-tag text-primary"></i>
                                        </span>
                                        <input type="text" class="form-control" id="promoCodeInput" 
                                               placeholder="Enter promo code if you have one" 
                                               value="<%= cart.promotion ? cart.promotion.code : '' %>">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="validatePromoBtn">
                                            Validate Code
                                        </button>
                                    </div>
                                    <div id="promoMessage" class="mb-2"></div>
                                    <% if (cart.promotion) { %>
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <strong>Promo Applied:</strong> <%= cart.promotion.code %> - 
                                            <%= cart.promotion.type === 'Percentage' ? cart.promotion.value + '%' : currencyPrefix + cart.promotion.value + currencySuffix %> discount
                                            <button type="button" class="btn-close" id="removePromoBtn" aria-label="Close"></button>
                                        </div>
                                    <% } %>
                                </div>

                                <div id="taxEstimateSection" style="display: none;">
                                    <p class="text-muted">Tax estimation will be calculated based on your billing address during checkout.</p>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- Empty Cart Message -->
                            <div class="text-center py-5">
                                <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                                <h5 class="mb-3">Your Shopping Cart is Empty</h5>
                                <a href="/clientarea/services?context=my" class="btn btn-primary">
                                    Continue Shopping
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Order Summary</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span id="orderSubtotal"><%= currencyPrefix %><%= subtotal.toFixed(2) %><%= currencySuffix %></span>
                        </div>
                        
                        <% if (discountAmount > 0) { %>
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Discount:</span>
                                <span id="orderDiscount">-<%= currencyPrefix %><%= discountAmount.toFixed(2) %><%= currencySuffix %></span>
                            </div>
                        <% } %>

                        <% if (taxAmountAfterDiscount > 0) { %>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax <% if (typeof taxCalculation !== 'undefined' && taxCalculation && taxCalculation.taxRateLevel2 > 0) { %>
                                    @ <%= taxCalculation.taxRateLevel1.toFixed(2) %>% + <%= taxCalculation.taxRateLevel2.toFixed(2) %>% (Compound)
                                <% } else { %>
                                    @ <%= taxRate.toFixed(2) %>%
                                <% } %>:</span>
                                <span id="orderTax"><%= currencyPrefix %><%= taxAmountAfterDiscount.toFixed(2) %><%= currencySuffix %></span>
                            </div>
                        <% } %>

                        <hr>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Totals:</span>
                            <span id="orderTotal">
                                <%= currencyPrefix %><%= total.toFixed(2) %><%= currencySuffix %>
                                <% 
                                    let billingCycleDisplay = '';
                                    if (hasProductItems && !hasDomainItems) {
                                        const productItem = cartItems.find(item => !item.type || item.type !== 'domain');
                                        billingCycleDisplay = productItem?.billingCycle || 'Monthly';
                                    } else if (hasDomainItems && !hasProductItems) {
                                        const domainItem = cartItems.find(item => item.type === 'domain');
                                        billingCycleDisplay = domainItem?.billingCycle || 'Annually';
                                    } else if (hasProductItems && hasDomainItems) {
                                        const productItem = cartItems.find(item => !item.type || item.type !== 'domain');
                                        billingCycleDisplay = productItem?.billingCycle || 'Monthly';
                                    }
                                %>
                                <%= billingCycleDisplay %>
                            </span>
                        </div>

                        <div class="mt-3 p-3 bg-light rounded">
                            <div class="fw-bold mb-1">Total Due Today</div>
                            <div class="h4 mb-0 text-primary" id="totalDueToday">
                                <%= currencyPrefix %><%= total.toFixed(2) %><%= currencySuffix %>
                            </div>
                        </div>

                        <% if (cartHasItems) { %>
                            <div class="d-grid gap-2 mt-4">
                                <a href="/orderforms/<%= formId %>?step=checkout" 
                                   class="btn btn-primary btn-lg">
                                    Checkout →
                                </a>
                                <a href="/clientarea/services?context=my" 
                                   class="btn-continue-shopping">
                                    ← Continue Shopping
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Remove Item / Empty Cart Confirmation Modal -->
<div class="modal fade" id="removeItemModal" tabindex="-1" aria-labelledby="removeItemModalLabel" aria-hidden="true" style="z-index: 20000;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 40px rgba(0,0,0,0.15); position: relative; pointer-events: auto;">
            <button type="button" id="closeRemoveModalBtn" aria-label="Close"
                style="position: absolute; top: 1rem; right: 1rem; background-color: #ff6b6b; border: none; border-radius: 50%; width: 30px; height: 30px; padding: 0; z-index: 10; color: #fff; font-size: 18px; line-height: 30px; cursor: pointer;">
                &times;
            </button>
            <div class="modal-body text-center" style="padding: 2rem;">
                <div class="mb-3">
                    <i class="fas fa-trash-alt" style="font-size: 64px; color: #ff6b6b; opacity: 0.8;"></i>
                </div>
                <h5 class="modal-title mb-3" id="removeItemModalLabel"
                    style="color: #dc3545; font-weight: 600; font-size: 24px;">Remove Item</h5>
                <p class="text-muted mb-4 remove-modal-message" style="font-size: 16px; color: #6c757d;">
                    Are you sure you want to remove this item from your cart?
                </p>
                <div class="row g-3 justify-content-center">
                    <div class="col-5">
                        <button type="button" class="btn btn-outline-secondary w-100" id="cancelRemoveBtn">No</button>
                    </div>
                    <div class="col-5">
                        <button type="button" class="btn btn-primary w-100" id="confirmRemoveBtn">Yes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const csrfToken = (typeof window.csrfToken === 'string' && window.csrfToken)
        ? window.csrfToken
        : <%- JSON.stringify(typeof csrfTokenValue !== 'undefined' && csrfTokenValue ? csrfTokenValue : (typeof token !== 'undefined' ? token : '')) %>;

    // Domain period selection
    const periodSelects = document.querySelectorAll('.domain-period-select');
    periodSelects.forEach(select => {
        select.addEventListener('change', function() {
            const itemId = this.dataset.itemId;
            const itemType = this.dataset.itemType;
            const cycle = this.value;
            const formId = '<%= formId %>';
            
            // Disable select to prevent double submission
            this.disabled = true;

            const headers = {
                'Content-Type': 'application/json'
            };
            if (csrfToken) {
                headers['X-CSRF-Token'] = csrfToken;
            }
            
            fetch(`/orderforms/${formId}/cart/update`, {
                method: 'POST',
                headers: headers,
                body: JSON.stringify({
                    itemId: itemId,
                    type: itemType,
                    cycle: cycle
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Failed to update: ' + (data.message || 'Unknown error'));
                    this.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating the cart.');
                this.disabled = false;
            });
        });
    });

    const promoCodeInput = document.getElementById('promoCodeInput');
    const validatePromoBtn = document.getElementById('validatePromoBtn');
    const promoMessage = document.getElementById('promoMessage');
    const promoCodeTab = document.getElementById('promoCodeTab');
    const estimateTaxesTab = document.getElementById('estimateTaxesTab');
    const promoCodeSection = document.getElementById('promoCodeSection');
    const taxEstimateSection = document.getElementById('taxEstimateSection');
    const removePromoBtn = document.getElementById('removePromoBtn');

    // Tab switching
    if (promoCodeTab && estimateTaxesTab) {
        promoCodeTab.addEventListener('click', function() {
            promoCodeSection.style.display = 'block';
            taxEstimateSection.style.display = 'none';
            promoCodeTab.style.backgroundColor = '#e9ecef';
            estimateTaxesTab.classList.remove('fw-bold');
        });

        estimateTaxesTab.addEventListener('click', function() {
            promoCodeSection.style.display = 'none';
            taxEstimateSection.style.display = 'block';
            promoCodeTab.style.backgroundColor = '';
            estimateTaxesTab.classList.add('fw-bold');
        });
    }

    // Validate promotion code
    if (validatePromoBtn) {
        validatePromoBtn.addEventListener('click', async function() {
            const code = promoCodeInput.value.trim().toUpperCase();
            
            if (!code) {
                promoMessage.innerHTML = '<div class="alert alert-warning">Please enter a promotion code</div>';
                return;
            }

            validatePromoBtn.disabled = true;
            validatePromoBtn.textContent = 'Validating...';

            try {
                // Get cart data from current page
                const cartData = {
                    items: [
                        <% if (cartItems.length > 0) { %>
                            <% cartItems.forEach(item => { %>
                                {
                                    id: '<%= item.id %>',
                                    type: '<%= item.type || 'product' %>',
                                    price: {
                                        value: <%= item.price ? (item.price.value || 0) : 0 %>
                                    },
                                    billingCycle: '<%= item.billingCycle || '' %>'
                                },
                            <% }); %>
                        <% } %>
                    ]
                };

                const promoHeaders = {
                    'Content-Type': 'application/json'
                };
                if (csrfToken) {
                    promoHeaders['X-CSRF-Token'] = csrfToken;
                }

                const response = await fetch('/api/promotions/validate', {
                    method: 'POST',
                    headers: promoHeaders,
                    body: JSON.stringify({
                        code: code,
                        cart: cartData
                    })
                });

                const data = await response.json();

                if (data.success) {
                    promoMessage.innerHTML = '<div class="alert alert-success">Promotion code applied successfully! Refreshing...</div>';
                    
                    // Save promotion to session via API
                    try {
                        await fetch('/api/promotions/apply', {
                            method: 'POST',
                            headers: promoHeaders,
                            body: JSON.stringify(data)
                        });
                    } catch (err) {
                        console.error('Error saving promotion:', err);
                    }
                    
                    // Reload page to show updated totals
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    promoMessage.innerHTML = `<div class="alert alert-danger">${data.error || 'Invalid promotion code'}</div>`;
                }
            } catch (error) {
                console.error('Error validating promo code:', error);
                promoMessage.innerHTML = '<div class="alert alert-danger">Error validating promotion code. Please try again.</div>';
            } finally {
                validatePromoBtn.disabled = false;
                validatePromoBtn.textContent = 'Validate Code';
            }
        });

        // Allow Enter key to validate
        if (promoCodeInput) {
            promoCodeInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    validatePromoBtn.click();
                }
            });
        }
    }

    // Remove promotion
    if (removePromoBtn) {
        removePromoBtn.addEventListener('click', async function() {
            try {
                // Remove promotion from session/cart
                const removePromoHeaders = {
                    'Content-Type': 'application/json'
                };
                if (csrfToken) {
                    removePromoHeaders['X-CSRF-Token'] = csrfToken;
                }
                const response = await fetch('/api/promotions/remove', {
                    method: 'POST',
                    headers: removePromoHeaders
                });

                if (response.ok) {
                    window.location.reload();
                }
            } catch (error) {
                console.error('Error removing promotion:', error);
                // Force reload anyway
                window.location.reload();
            }
        });
    }

    let removeUrl = null;
    const removeItemModal = document.getElementById('removeItemModal');
    if (removeItemModal && removeItemModal.parentElement !== document.body) {
        document.body.appendChild(removeItemModal);
    }

    function hideRemoveModal() {
        const modal = document.getElementById('removeItemModal');
        if (modal) {
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal && typeof bootstrap.Modal.getInstance === 'function') {
                const inst = bootstrap.Modal.getInstance(modal);
                if (inst) {
                    try { inst.dispose(); } catch (err) { /* ignore */ }
                }
            }
            modal.classList.remove('show');
            modal.style.display = 'none';
            modal.setAttribute('aria-hidden', 'true');
            modal.removeAttribute('aria-modal');
        }
        document.querySelectorAll('.modal-backdrop').forEach(function (el) { el.remove(); });
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('overflow');
        document.body.style.removeProperty('padding-right');
        removeUrl = null;
        const confirmBtn = document.getElementById('confirmRemoveBtn');
        if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Yes';
        }
    }

    function showRemoveModal() {
        const modal = document.getElementById('removeItemModal');
        if (!modal) return;
        if (modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
        modal.classList.add('show');
        modal.style.display = 'block';
        modal.style.zIndex = '20000';
        modal.removeAttribute('aria-hidden');
        modal.setAttribute('aria-modal', 'true');
        document.body.classList.add('modal-open');
        if (!document.getElementById('removeItemModalBackdrop')) {
            const backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            backdrop.id = 'removeItemModalBackdrop';
            backdrop.style.zIndex = '19990';
            document.body.appendChild(backdrop);
        }
    }

    function submitRemove() {
        if (!removeUrl) return;
        const confirmBtn = document.getElementById('confirmRemoveBtn');
        if (confirmBtn) {
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...';
        }
        const tempForm = document.createElement('form');
        tempForm.method = 'POST';
        tempForm.action = removeUrl;
        if (csrfToken) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = csrfToken;
            tempForm.appendChild(input);
        }
        document.body.appendChild(tempForm);
        tempForm.submit();
    }

    document.addEventListener('click', function (e) {
        const removeBtn = e.target.closest('.remove-item-btn');
        if (removeBtn) {
            e.preventDefault();
            e.stopPropagation();
            const form = removeBtn.closest('form');
            removeUrl = form ? form.getAttribute('action') : removeBtn.getAttribute('data-form-action');
            const modal = document.getElementById('removeItemModal');
            if (modal) {
                const titleEl = modal.querySelector('#removeItemModalLabel');
                const messageEl = modal.querySelector('.remove-modal-message');
                if (titleEl) titleEl.textContent = removeBtn.getAttribute('data-confirm-title') || 'Remove Item';
                if (messageEl) messageEl.textContent = removeBtn.getAttribute('data-confirm-message') || 'Are you sure you want to remove this item from your cart?';
                showRemoveModal();
            }
            return;
        }

        if (e.target.closest('#confirmRemoveBtn')) {
            e.preventDefault();
            e.stopPropagation();
            submitRemove();
            return;
        }

        if (e.target.closest('#cancelRemoveBtn') || e.target.closest('#closeRemoveModalBtn')) {
            e.preventDefault();
            e.stopPropagation();
            hideRemoveModal();
            return;
        }

        if (e.target.id === 'removeItemModal' || e.target.id === 'removeItemModalBackdrop') {
            hideRemoveModal();
        }
    });
});
</script>
